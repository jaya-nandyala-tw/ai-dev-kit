# ── Atlassian Integration (Jira + Confluence) ──
# Required for atlassian_client/
JIRA_BASE_URL=https://<your-org>.atlassian.net
JIRA_API_TOKEN=your-atlassian-api-token-here
# DEV_EMAIL (defined elsewhere in your .env) is reused as the Atlassian auth email

# Optional — only set this if Confluence lives on a different site than Jira.
# Defaults to <JIRA_BASE_URL>/wiki, which is correct for most Atlassian Cloud setups.
# CONFLUENCE_BASE_URL=https://<your-org>.atlassian.net/wiki
